{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "cache": {
      "enabled": false
    },
    "analytics": "41e41591-e0a4-4cad-b992-d7acbe4e9b4c"
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "e2e": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.e2e.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "schedule-e2e": {
              "fileReplacements": [{ "replace": "src/environments/environment.ts", "with": "src/environments/environment.schedule-e2e.ts" }],
              "optimization": false, "extractLicenses": false, "sourceMap": true
            },
            "calendar-e2e": {
              "fileReplacements": [{ "replace": "src/environments/environment.ts", "with": "src/environments/environment.calendar-e2e.ts" }],
              "optimization": false, "extractLicenses": false, "sourceMap": true
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "lan": {
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.lan.ts"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            },
            "e2e": {
              "buildTarget": "frontend:build:e2e"
            },
            "schedule-e2e": { "buildTarget": "frontend:build:schedule-e2e" },
            "calendar-e2e": { "buildTarget": "frontend:build:calendar-e2e" },
            "lan": {
              "buildTarget": "frontend:build:lan",
              "host": "0.0.0.0",
              "proxyConfig": "proxy.lan.json",
              "ssl": true,
              "allowedHosts": ["platform.spanishnow.ar"],
              "headers": { "Cache-Control": "no-store" }
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
