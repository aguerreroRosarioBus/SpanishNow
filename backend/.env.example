# Server Configuration
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=spanishnow

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Admin panel: emails (comma separated, case-insensitive) that always have every admin permission and cannot be demoted or suspended from the panel
ADMIN_EMAILS=

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Test accounts password for `npm run db:seed:curated` (required when DB_HOST is not localhost)
# SEED_TEST_PASSWORD=

# --- Selling courses (phase 1) ---
# Base URL of the web app: used in checkout redirects and in email links. Required in production.
FRONTEND_URL=http://localhost:4200

# Hotmart: token (Tools > Webhook) that verifies the purchase webhook /api/payments/hotmart/webhook
HOTMART_HOTTOK=
# Public base URL of this API (e.g. https://api.example.com), shown to the teacher as the webhook URL. Optional.
# PUBLIC_API_URL=

# Stripe (Checkout), not usable from Argentina; courses with a Hotmart checkout link never use it. Secret key and the signing secret of the webhook endpoint /api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local development only, never in production (the server refuses to start): skips Stripe and marks the order paid right away
# PAYMENTS_FAKE=1

# Classes, chat and packages (docs/clases-chat-integraciones/CONTRATO.md §11): every module is off unless set to 1.
# Turning one off hides new features but never removes what students already bought.
# FEATURE_CHAT=1
# Chat (W04): aggregate limits over every conversation (CHAT-07) and the grouped unread email (CHAT-09).
# CHAT_ACCOUNT_MESSAGES_PER_HOUR=300
# CHAT_IP_ACTIONS_PER_HOUR=600
# CHAT_UNREAD_EMAIL=0                     # 0 turns the unread email off (it goes through the outbox: OUTBOX_WORKER=1)
# CHAT_UNREAD_EMAIL_DELAY_MINUTES=5
# CHAT_UNREAD_EMAIL_INTERVAL_MINUTES=30
# FEATURE_CLASS_PACKAGES=1
# FEATURE_CLASS_SCHEDULING=1
# FEATURE_GOOGLE_CALENDAR=1
# FEATURE_ZOOM=1
# Local development only, never in production (the server refuses to start): fake Google Calendar and Zoom adapters
# INTEGRATIONS_FAKE=1
# Runs the durable job worker (outbox_jobs) in this process. Safe with several replicas.
# OUTBOX_WORKER=1

# Email. log = print to the console and write backend/tmp/mail/*.json (default outside production); smtp = really send
MAIL_TRANSPORT=log
MAIL_FROM=SpanishNow <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Image search. Recommended: Pixabay (free catalog of photos, illustrations and vectors).
# Get your key after signing in at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Optional persistent writable cache directory. Pixabay responses are cached for 24 hours.
# Default: backend/tmp/image-search-cache; use a persistent volume in production.
# IMAGE_SEARCH_CACHE_DIR=
# Optional alternative: SerpApi (Google Images engine). Pixabay takes precedence.
# Keys stay on the server; selected images use the existing Cloudinary upload flow.
SERPAPI_API_KEY=
# Alternative for existing Google Custom Search JSON API customers:
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Live classes: enable Classroom API and Drive API in this Google Cloud project.
# OAuth client type: Web application. Redirect URI must exactly match this value.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/live-classes/google/callback
# Dedicated 32-byte base64 key. Generate once: openssl rand -base64 32
# Preserve this key across deploys; changing it requires teachers to reconnect Google.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# W08 Zoom. INTEGRATIONS_FAKE=1 usa el fake; sin el flag se exige la configuración real completa.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=http://localhost:3000/api/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=
# El adaptador real exige los cuatro valores; ZOOM_REDIRECT_URI debe ser HTTPS público en Zoom.
# Las credenciales se cifran con GOOGLE_TOKEN_ENCRYPTION_KEY (32 bytes en base64).
# Google Calendar del docente (W07). Reutiliza GOOGLE_OAUTH_CLIENT_ID/SECRET y GOOGLE_TOKEN_ENCRYPTION_KEY.
# Activar con FEATURE_GOOGLE_CALENDAR=1. Habilitar la Calendar API en el mismo proyecto de Google Cloud y registrar este redirect URI.
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/integrations/google-calendar/callback
# Opcional: URL HTTPS pública de .../api/integrations/google-calendar/notifications para canales push. Si falta, sincroniza por sondeo (cada 5 min).
# GOOGLE_CALENDAR_NOTIFICATIONS_URL=
