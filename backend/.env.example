# Server Configuration
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=spanishnow

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Test accounts password for `npm run db:seed:curated` (required when DB_HOST is not localhost)
# SEED_TEST_PASSWORD=

# --- Selling courses (phase 1) ---
# Base URL of the web app: used in checkout redirects and in email links. Required in production.
FRONTEND_URL=http://localhost:4200

# Stripe (Checkout). Secret key and the signing secret of the webhook endpoint /api/payments/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Local development only, never in production (the server refuses to start): skips Stripe and marks the order paid right away
# PAYMENTS_FAKE=1

# Email. log = print to the console and write backend/tmp/mail/*.json (default outside production); smtp = really send
MAIL_TRANSPORT=log
MAIL_FROM=SpanishNow <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Image search. Recommended: Pixabay (free catalog of photos, illustrations and vectors).
# Get your key after signing in at https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Optional persistent writable cache directory. Pixabay responses are cached for 24 hours.
# Default: backend/tmp/image-search-cache; use a persistent volume in production.
# IMAGE_SEARCH_CACHE_DIR=
# Optional alternative: SerpApi (Google Images engine). Pixabay takes precedence.
# Keys stay on the server; selected images use the existing Cloudinary upload flow.
SERPAPI_API_KEY=
# Alternative for existing Google Custom Search JSON API customers:
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Live classes: enable Classroom API and Drive API in this Google Cloud project.
# OAuth client type: Web application. Redirect URI must exactly match this value.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/live-classes/google/callback
# Dedicated 32-byte base64 key. Generate once: openssl rand -base64 32
# Preserve this key across deploys; changing it requires teachers to reconnect Google.
GOOGLE_TOKEN_ENCRYPTION_KEY=
