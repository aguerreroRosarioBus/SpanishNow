# Variables de la aplicación en producción (deploy/.env.api, permiso 600, NO va al repositorio).
# Los valores __GENERAR__ los crea instalar.sh; el resto los carga Andrés a mano.
# Ya fijados por docker-compose.yml (no repetir acá): NODE_ENV, PORT, DB_*, TRUST_PROXY, OUTBOX_WORKER.
# En producción el servidor se niega a arrancar con PAYMENTS_FAKE o INTEGRATIONS_FAKE: no usarlos.

# --- Dirección pública ---
FRONTEND_URL=https://platform.spanishnow.ar
# Base pública de la API: la usa la pantalla de Hotmart para mostrar la URL del webhook.
PUBLIC_API_URL=https://platform.spanishnow.ar

# --- Sesión y administración ---
JWT_SECRET=__GENERAR__
# Correos (separados por coma) con todos los permisos de administración.
ADMIN_EMAILS=

# --- Cloudinary (imágenes y audios subidos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Hotmart ---
# Token de Herramientas > Webhook que verifica /api/payments/hotmart/webhook.
HOTMART_HOTTOK=

# --- Correo (Brevo, plan gratuito) ---
MAIL_TRANSPORT=smtp
MAIL_FROM=SpanishNow <no-reply@spanishnow.ar>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Búsqueda de imágenes ---
PIXABAY_API_KEY=

# --- Google (Classroom/Drive y Calendar) y Zoom ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://platform.spanishnow.ar/api/live-classes/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://platform.spanishnow.ar/api/integrations/google-calendar/callback
# Clave de 32 bytes que cifra los tokens de Google y Zoom. GUARDARLA TAMBIÉN en el gestor de contraseñas, fuera del
# servidor: si se pierde, hay que reconectar todas las cuentas aunque se restaure la base.
GOOGLE_TOKEN_ENCRYPTION_KEY=__GENERAR__
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://platform.spanishnow.ar/api/integrations/zoom/callback
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Módulos de clases, chat y paquetes ---
# Apagados mientras no valgan 1 (activarlos es una decisión de producto de Andrés; no borra nada comprado).
# FEATURE_CHAT=1
# FEATURE_CLASS_PACKAGES=1
# FEATURE_CLASS_SCHEDULING=1
# FEATURE_GOOGLE_CALENDAR=1
# FEATURE_ZOOM=1
