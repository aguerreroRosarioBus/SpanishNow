# Variables de docker-compose y de los scripts de backup (deploy/.env, permiso 600, NO va al repositorio).
# Los valores __GENERAR__ los crea instalar.sh. Los secretos de la aplicación van en .env.api.

# Base de datos (los crea instalar.sh)
MYSQL_ROOT_PASSWORD=__GENERAR__
DB_NAME=spanishnow
DB_USER=spanishnow
DB_PASSWORD=__GENERAR__

# Red de Docker del Caddy compartido. En el VPS es la de Gestión.
EDGE_NETWORK=deploy_default

# --- Backup (DEP-04) ---
# Destino de la copia externa: un remote de rclone cifrado que apunta a Google Drive (README.md §Backup).
# Ejemplo: gdrive-crypt:  (con los dos puntos). Vacío = sin copia externa: backup.sh falla a propósito.
BACKUP_REMOTE=
# Solo para pruebas locales: 1 permite que backup.sh termine bien sin copia externa.
BACKUP_SIN_COPIA_EXTERNA=0
# Alertas por ausencia (healthchecks.io): la URL de cada chequeo, sin barra final. Vacío = sin alerta.
HC_BACKUP_URL=
HC_VERIFY_URL=
