# Frontend de SpanishNow servido por nginx (DEP-01, DEP-02). Contexto de construcción: la raíz del repositorio.
FROM node:24-alpine AS build
WORKDIR /app
# El build de Angular es lo que más memoria pide: se le da techo explícito para que no dispare el OOM del servidor.
ENV NODE_OPTIONS=--max-old-space-size=1536
# .npmrc trae legacy-peer-deps=true: sin él, npm ci rechaza el conflicto de peers de ng-bootstrap.
COPY frontend/package.json frontend/package-lock.json frontend/.npmrc ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/frontend/browser /usr/share/nginx/html
